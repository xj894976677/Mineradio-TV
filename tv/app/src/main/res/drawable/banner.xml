<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 Leanback banner: the MR mark on the stage's near-black. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient android:angle="315" android:startColor="#16121F" android:endColor="#050508" />
        </shape>
    </item>
    <item android:drawable="@mipmap/ic_launcher" android:gravity="center" android:width="112dp" android:height="112dp" />
</layer-list>
